---
import Layout from "../layouts/Layout.astro";
import FuzzyText from "../components/FuzzyText";
import Container from "../components/Container.astro";
import Form from "../components/Form.astro";
import LinkButton from "../components/LinkButton.astro";
import Section1 from "../components/Section1.astro";
---

<Layout title="fabiodicec.ca">
  <Section1>
    <div class="w-full max-w-sm">
      <FuzzyText
        text="Under\nConstruction"
        baseIntensity={0.06}
        hoverIntensity={0.5}
        color="#000000"
        fontSize="clamp(2.5rem, 8vw, 4.5rem)"
        fontWeight={700}
        className="-ml-[20px] w-[calc(100%+40px)] max-w-none h-auto block"
        client:load
      />
    </div>

    <p class="w-full max-w-sm">Thanks for stopping by.
At the moment my portfolio is under construction, but feel free to have a look at the links below.
Otherwise send me a message.</p>

    <div class="flex flex-row gap-4 mt-4">
      <LinkButton
        href="https://github.com/fabbbiodc"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </LinkButton>

      <LinkButton
        href="https://linkedin.com/in/fabiodicecca"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </LinkButton>
    </div>
    <Form />
    <div
      id="success-message"
      class="hidden text-black text-xl font-bold mt-4 text-center"
    >
      Message sent!
I'll get back to you soon.
    </div>

    <div
      id="error-message"
      class="hidden text-red-400 text-lg font-bold mt-4 text-center"
    >
      Something went wrong.
Please try again.
    </div>
  </Section1>

  <script>
    const form = document.querySelector("[data-w3c]") as HTMLFormElement;
    const successMessage = document.getElementById("success-message");
    const errorMessage = document.getElementById("error-message");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((value, key) => {
        data[key] = value.toString();
      });

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          form.classList.add("hidden");
          successMessage?.classList.remove("hidden");
        } else {
          errorMessage?.classList.remove("hidden");
        }
      } catch {
        errorMessage?.classList.remove("hidden");
      }
    });
  </script>
</Layout>