---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const programmingProjects = await getCollection("programming");
const designProjects = await getCollection("design");
const allProjects = [
  { category: "Programming", items: programmingProjects },
  { category: "Design", items: designProjects },
];
---

<Layout title="Projects | My Portfolio">
  <h1 class="text-3xl font-bold text-brand mb-6">My Projects</h1>
  {
    allProjects.map((group) => (
      <section class="mb-8">
        <h2 class="text-2xl font-semibold text-text mb-4">{group.category}</h2>

        {group.items.length === 0 ? (
          <p class="text-text opacity-70">No projects yet.</p>
        ) : (
          <ul class="space-y-4">
            {group.items.map((project) => (
              <li class="border border-text p-4 rounded">
                <h3 class="text-xl font-medium text-brand">{project.id}</h3>
                <p class="text-text">Project placeholder</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</Layout>
