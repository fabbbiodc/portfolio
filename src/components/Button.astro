---
import { buttonPrimary } from "../styles/styles";

export interface Props {
  text: string;
  class?: string;
  [key: string]: any;
}

const { text, class: className, ...rest } = Astro.props;
---

<button class={`${className ?? ""} ${buttonPrimary}`} {...rest}>
  {text}
</button>

<style>
  button::before {
    content: ">";
    margin-right: 0.25em;
  }
</style>
