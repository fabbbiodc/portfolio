---
// Theme toggle component
import SunIcon from "heroicons/24/solid/sun.svg";
import MoonIcon from "heroicons/24/solid/moon.svg";

interface Props {
  id: string;
}
const { id } = Astro.props;

const toggleClass =
  "p-2 rounded hover:bg-opacity-20 hover:bg-brand transition bloom-text";
---

<button id={id} class={toggleClass}>
  <SunIcon id="sun-icon" class="w-6 h-6 text-brand bloom-text" />
  <MoonIcon id="moon-icon" class="w-6 h-6 text-brand bloom-text hidden" />
</button>

<script>
  import { toggleTheme, setTheme, updateThemeUI } from "../utils/theme";

  let currentTheme = localStorage.getItem("theme-preference") || "light";

  function handleToggle() {
    const newTheme = toggleTheme(currentTheme);
    setTheme(newTheme);
    updateThemeUI(newTheme);
    currentTheme = newTheme;
  }

  // Attach click listeners to both buttons
  const desktopBtn = document.getElementById("theme-toggle-desktop");
  const mobileBtn = document.getElementById("theme-toggle-mobile");

  desktopBtn?.addEventListener("click", handleToggle);
  mobileBtn?.addEventListener("click", handleToggle);

  // Initialize icon display on page load
</script>
