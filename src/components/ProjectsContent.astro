---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<div class="flex flex-col gap-4">
  {projects.map((project) => (
    <ProjectCard
      id={project.id}
      title={project.title}
      tags={project.tags}
      thumbnail={project.thumbnail}
    />
  ))}
</div>
