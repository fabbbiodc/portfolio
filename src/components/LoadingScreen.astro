---
import { loadingContainerStyle } from "../styles/styles";
import Button from "./Button.astro";
---

<div
  id="loading-overlay"
  class="fixed inset-0 z-50 flex items-center justify-center"
>
  <div class={loadingContainerStyle}>
    <div style="width: 260px">
      <div class="w-full h-4 bg-bg-dark/15">
        <div
          id="loading-bar-fill"
          class="h-full bg-text-primary transition-all duration-300"
          style="width: 0%"
        >
        </div>
      </div>
      <p id="loading-percent" class="text-center mt-3 text-text-primary">0%</p>
      <div class="text-center mt-6">
        <Button id="start-btn" text="start" class="hidden" />
      </div>
    </div>
  </div>
</div>
