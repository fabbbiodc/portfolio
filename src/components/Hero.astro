---
// Hero navigation component
import HeroLink from "./HeroLink.astro";
---

<div class="pl-2 pr-6 py-8 h-auto md:h-72">
  <nav class="space-y-2 font-mono text-text">
    <HeroLink
      name="about"
      displayName="about......."
      isSelected={false}
      dataSection="about"
    />
    <HeroLink
      name="projects"
      displayName="projects...."
      isSelected={false}
      dataSection="projects"
    />
    <HeroLink
      name="contact"
      displayName="contact....."
      isSelected={false}
      dataSection="contact"
    />
  </nav>
  <div class="hidden md:flex justify-center pl-4 pt-4 bloom-text">
    <div class="text-left">
      <p class="caption">↑ ↓ navigate</p>
      <p class="caption">↵ select</p>
      <p class="caption">esc clear</p>
    </div>
  </div>
</div>

<script>
  // Terminal navigation keys
  const links = document.querySelectorAll(
    ".hero-link",
  ) as NodeListOf<HTMLAnchorElement>;
  let currentIndex = -1;
  let hasInteracted = false;

  function updateSelection(newIndex: number) {
    // Update data-state on all links for CSS styling
    links.forEach((link, index) => {
      link.dataset.state = index === newIndex ? "selected" : "default";

      // Update the prefix text based on state
      const wrapper = link.querySelector(".hero-link-wrapper");
      const prefix = link.querySelector(".hero-link-prefix");

      if (index === newIndex) {
       if (prefix) prefix.textContent = "> ";
        wrapper?.setAttribute("data-state", "selected");
      } else {
        if (prefix) prefix.textContent = "\u00A0\u00A0";
        wrapper?.setAttribute("data-state", "default");
      }
    });

    if (newIndex >= 0 && newIndex < links.length) {
      currentIndex = newIndex;
      const sectionKey = links[newIndex].dataset.section!;
      (
        window as Window & { updatePreviewGlobal?: (key: string) => void }
      ).updatePreviewGlobal?.(sectionKey);
    }
  }

  function cancelSelection(): void {
    currentIndex = -1;
    links.forEach((link) => {
      link.dataset.state = "default";

      const wrapper = link.querySelector(".hero-link-wrapper");
      const prefix = link.querySelector(".hero-link-prefix");

      if (prefix) prefix.textContent = "\u00A0\u00A0";
      wrapper?.setAttribute("data-state", "default");
    });
    (
      window as unknown as Window & {
        updatePreviewGlobal?: (key: string) => void;
      }
    ).updatePreviewGlobal?.("initial");
  }

  // Keyboard handlers
  document.addEventListener("keydown", (event) => {
    if (event.key === "ArrowUp") {
      event.preventDefault();
      hasInteracted = true;
      if (currentIndex === -1) {
        updateSelection(links.length - 1);
      } else {
        const newIndex =
          currentIndex === 0 ? links.length - 1 : currentIndex - 1;
        updateSelection(newIndex);
      }
    } else if (event.key === "ArrowDown") {
      event.preventDefault();
      hasInteracted = true;
      if (currentIndex === -1) {
        updateSelection(0);
      } else {
        const newIndex =
          currentIndex === links.length - 1 ? 0 : currentIndex + 1;
        updateSelection(newIndex);
      }
    } else if (event.key === "Enter") {
      if (currentIndex >= 0 && currentIndex < links.length) {
        links[currentIndex].click();
      }
    } else if (event.key === "Escape") {
      event.preventDefault();
      cancelSelection();
    }
  });

  // Mouse handlers
  links.forEach((link, index) => {
    link.addEventListener("click", () => {
      hasInteracted = true;
      updateSelection(index);
    });
    link.addEventListener("mouseenter", () => {
      updateSelection(index);
    });
  });
</script>
