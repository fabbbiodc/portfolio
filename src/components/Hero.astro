---
// Hero navigation component
---

<div class="border border-text pl-2 pr-6 py-8 h-auto md:h-64 bloom-border">
  <nav class="space-y-2 font-mono text-text">
    <a href="/about" class="hero-link" data-section="about">about.......</a>
    <a href="/projects" class="hero-link" data-section="projects">projects....</a>
    <a href="/contact" class="hero-link" data-section="contact">contact.....</a>
  </nav>
  <div class="hidden md:flex justify-center pt-4">
    <div class="text-left">
      <p class="caption">↑ ↓ navigate</p>
      <p class="caption">↵ select</p>
      <p class="caption">esc clear</p>
    </div>
  </div>
</div>

<style>
  .hero-link {
    display: block;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.2s ease;
    /*TODO change pointer?*/
    cursor: pointer;
    white-space: pre;
    filter: drop-shadow(0 0 4px var(--color-bloom));
  }

  /*.hero-link:hover {
      opacity: 0.8;
  }*/

  .hero-link[data-state="selected"] {
    background-color: var(--color-text);
    color: var(--color-background);
  }

  
</style>

<script>
  // Terminal navigation keys
  const links = document.querySelectorAll(
    ".hero-link",
  ) as NodeListOf<HTMLAnchorElement>;
  let currentIndex = -1;
  let hasInteracted = false;

  const originalTexts = Array.from(links).map((link) =>
    link.textContent.trim(),
  );

  // Initialize all links with two-space padding on page load
  links.forEach((link, index) => {
    link.textContent = "  " + originalTexts[index];
    link.dataset.state = "default";
  });

  function updateSelection(newIndex: number) {
    links.forEach((link, index) => {
      link.dataset.state = "default";
      link.textContent = "  " + originalTexts[index];
    });

    if (newIndex >= 0 && newIndex < links.length) {
      links[newIndex].dataset.state = "selected";
      links[newIndex].textContent = "> " + originalTexts[newIndex];
      currentIndex = newIndex;
      const sectionKey = (links[newIndex] as HTMLAnchorElement).dataset
        .section!;
      (
        window as Window & { updatePreviewGlobal?: (key: string) => void }
      ).updatePreviewGlobal?.(sectionKey);
    }
  }

  function cancelSelection(): void {
    currentIndex = -1;

    links.forEach((link, index) => {
      link.dataset.state = "default";
      link.textContent = "  " + originalTexts[index];
    });
    (
      window as unknown as Window & {
        updatePreviewGlobal?: (key: string) => void;
      }
    ).updatePreviewGlobal?.("initial");
  }

  document.addEventListener("keydown", (event) => {
    if (event.key === "ArrowUp") {
      event.preventDefault();
      hasInteracted = true;
      if (currentIndex === -1) {
        updateSelection(links.length - 1);
      } else {
        const newIndex =
          currentIndex === 0 ? links.length - 1 : currentIndex - 1;
        updateSelection(newIndex);
      }
    } else if (event.key === "ArrowDown") {
      event.preventDefault();
      hasInteracted = true;
      if (currentIndex === -1) {
        updateSelection(0);
      } else {
        const newIndex =
          currentIndex === links.length - 1 ? 0 : currentIndex + 1;
        updateSelection(newIndex);
      }
    } else if (event.key === "Enter") {
      if (currentIndex >= 0 && currentIndex < links.length) {
        (links[currentIndex] as HTMLAnchorElement).click();
      }
    } else if (event.key === "Escape") {
      event.preventDefault();
      cancelSelection();
    }
  });

  links.forEach((link, index) => {
    link.addEventListener("click", (event) => {
      hasInteracted = true;
      updateSelection(index);
    });
    link.addEventListener("mouseenter", () => {
      updateSelection(index);
    });

    link.addEventListener("mouseleave", () => {
      currentIndex = -1;
      links.forEach((link, i) => {
        link.dataset.state = "default";
        link.textContent = "  " + originalTexts[i];
      });
      (
        window as unknown as Window & {
          updatePreviewGlobal?: (key: string) => void;
        }
      ).updatePreviewGlobal?.("initial");
    });
  });
</script>
