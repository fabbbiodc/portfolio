---
// Hero Section
import DragContainer from "./DragContainer.astro";
import TextType from "./TextType.astro";
import LoadingScreen from "./LoadingScreen.astro";
import Button from "./Button.astro";

const asciiText = [
  "██████ ▄▄▄  ▄▄▄▄  ▄▄  ▄▄▄",
  "██▄▄  ██▀██ ██▄██ ██ ██▀██",
  "██    ██▀██ ██▄█▀ ██ ▀███▀",
  "",
  "████▄  ▄▄   ▄█████ ▄▄▄▄▄  ▄▄▄▄  ▄▄▄▄  ▄▄▄",
  "██  ██ ██   ██     ██▄▄  ██▀▀▀ ██▀▀▀ ██▀██",
  "████▀  ██   ▀█████ ██▄▄▄ ▀████ ▀████ ██▀██",
].join("\n");

const mobileName = "Fabio\nDi Cecca";
---

<div
  class="relative w-full min-h-screen flex flex-col items-center justify-start md:flex-row md:justify-end md:pr-10 lg:pr-20 overflow-hidden"
  style="height: 100dvh;"
>
  <canvas id="hero-animation" class="-z-10 block"></canvas>

  <LoadingScreen />

  <div id="page-content" class="hidden">
    <DragContainer
      id="home"
      title="fabiodicec.ca"
      positionStrategy="home"
      closable={false}
    >
      <div
        class="hidden md:block font-mono"
        style="height: 110px; width: 300px; overflow: hidden; font-size: 0.75rem;"
      >
        <TextType
          text={asciiText}
          typingSpeed={10}
          pauseDuration={800}
          loop={false}
          showCursor={false}
          startOnVisible={true}
        />
      </div>
      <div
        class="md:hidden uppercase"
        style="height: 5rem; overflow: hidden; font-size: 1.5rem;"
      >
        <TextType
          text={mobileName}
          typingSpeed={120}
          loop={false}
          startOnVisible={true}
        />
      </div>
      <div class="flex flex-col items-start gap-2 mt-4">
        <Button
          text="projects"
          data-action="open-window"
          data-target="projects"
        />
        <Button
          text="about-me"
          data-action="open-window"
          data-target="about-me"
        />
      </div>
    </DragContainer>
    <DragContainer
      id="projects"
      title="projects"
      positionStrategy="child"
      parentId="home"
      initiallyHidden
    >
      <h1>Projects Window</h1>
      <Button text="details" data-action="open-window" data-target="details" />
    </DragContainer>
    <DragContainer
      id="about-me"
      title="about me"
      positionStrategy="child"
      parentId="home"
      initiallyHidden
    >
      <h1>Ciao come va</h1>
      <!-- <Button text="details" data-action="open-window" data-target="details" /> -->
    </DragContainer>
    <DragContainer
      id="details"
      title="details"
      positionStrategy="child"
      parentId="projects"
      initiallyHidden
    >
      <p>Details about the selected project go here.</p>
    </DragContainer>
  </div>
</div>

<script>
  import "../scripts/heroAnimation.ts";
  import { manager } from "../scripts/draggable.ts";

  document.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest(
      '[data-action="open-window"]',
    );
    if (target) {
      const windowId = target.getAttribute("data-target");
      if (windowId) manager.openWindow(windowId);
    }
  });
</script>
