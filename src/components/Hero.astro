---
// Hero Section

import Window from "./Window.astro";
import HeroContent from "./HeroContent.astro";
import ProjectsContent from "./ProjectsContent.astro";
import AboutMeContent from "./AboutMeContent.astro";
import CvContent from "./CvContent.astro";
import ProjectDetail from "./ProjectDetail.astro";
import LoadingScreen from "./LoadingScreen.astro";
import Footer from "./Footer.astro";
import ImpressumContent from "./ImpressumContent.astro";
import CreditsContent from "./CreditsContent.astro";
---

<div
  class="relative w-full min-h-screen flex flex-col items-center justify-start md:flex-row md:justify-end md:pr-10 lg:pr-20 overflow-hidden"
  style="height: 100dvh;"
>
  <canvas id="hero-animation" class="-z-10 pointer-events-none block"></canvas>

  <LoadingScreen />

  <div id="page-content" class="hidden">
    <Window
      id="home"
      title="fabiodicec.ca"
      positionStrategy="home"
      closable={false}
    >
      <HeroContent />
    </Window>
    <Window
      id="projects"
      title="projects"
      positionStrategy="child"
      parentId="home"
      initiallyHidden
    >
      <ProjectsContent />
    </Window>
    <Window
      id="about-me"
      title="about me"
      positionStrategy="child"
      parentId="home"
      initiallyHidden
    >
      <AboutMeContent />
    </Window>
    <Window
      id="cv"
      title="curriculum"
      positionStrategy="child"
      parentId="about-me"
      initiallyHidden
    >
      <CvContent />
    </Window>
    <Window
      id="details"
      title="details"
      positionStrategy="child"
      parentId="projects"
      initiallyHidden
    >
      <ProjectDetail />
    </Window>
  </div>
  <Window
    id="impressum"
    title="impressum"
    positionStrategy="child"
    parentId="home"
    initiallyHidden
  >
    <ImpressumContent />
  </Window>
  <Window
    id="credits"
    title="credits"
    positionStrategy="child"
    parentId="home"
    initiallyHidden
  >
    <CreditsContent />
  </Window>
  <Footer />
</div>

<script>
  import "../scripts/heroAnimation.ts";
  import { manager } from "../scripts/draggable.ts";

  document.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest(
      '[data-action="open-window"]',
    );
    if (target) {
      const windowId = target.getAttribute("data-target");
      const projectTitle = target.getAttribute("data-project-title");
      const projectId = target.getAttribute("data-project-id");
      
      if (windowId) {
        const windowEl = document.querySelector(`[data-window-id="${windowId}"]`);
        if (windowEl) {
          // Update titlebar
          if (projectTitle) {
            const titlebar = windowEl.querySelector(".titlebar");
            if (titlebar) {
              const titleElement = titlebar.querySelector("[data-title]");
              if (titleElement) {
                titleElement.textContent = projectTitle;
              }
            }
          }
          // Show matching project content
          if (projectId) {
            windowEl.querySelectorAll("[data-project-content]").forEach((el) => {
              const content = el as HTMLElement;
              content.style.display = content.getAttribute("data-project-content") === projectId ? "block" : "none";
            });
          }
        }
        manager.openWindow(windowId);
      }
    }
  });
</script>
