---
// Draggable window

import Titlebar from "./Titlebar.astro";
import { draggableWindowStyle, containerContent } from "../styles/styles";

interface Props {
  id: string;
  title: string;
  initialX?: number;
  initialY?: number;
  closable?: boolean;
  initiallyHidden?: boolean;
}

const { id, title, initialX = 100, initialY = 100, closable = true, initiallyHidden = false } = Astro.props;
---

<div 
  class={`${draggableWindowStyle}`}
  data-window-id={id}
  style={`transform: translate(${initialX}px, ${initialY}px);${initiallyHidden ? ' display: none;' : ''}`}
>
  <Titlebar title={title} closable={closable} />
  <div class={containerContent}>
    <slot />
  </div>
</div>

<script>
  import "../scripts/draggable.ts";
</script>
