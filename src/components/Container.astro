---
// Generic container with flexible styling and optional titlebar

import { containerStyle } from "../styles/styles";
import Titlebar from "./Titlebar.astro";

interface Props {
  class?: string;
  showTitlebar?: boolean;
  title?: string;
}

const {
  class: customClass = "",
  showTitlebar = true,
  title = "",
} = Astro.props;
---

<div>
  {showTitlebar && <Titlebar title={title} />}
  <div class={`${containerStyle} ${customClass}`}>
    <slot />
  </div>
</div>
