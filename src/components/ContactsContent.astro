---
import Button from "./Button.astro";
import { buttonPrimary } from "../styles/styles";
---

<div class="flex flex-col gap-6">
  <p class="text-sm md:text-base">Get in touch:</p>

  <div class="flex flex-col gap-2">
    <a
      href="mailto:fabiodicecca@gmail.com"
      class="block px-4 py-2 w-fit no-underline bg-bg-dark text-text-bright hover:opacity-20"
    >
      > fabiodicecca[at]gmail.com
    </a>
    <a
      href="https://github.com/fabbbiodc"
      target="_blank"
      rel="noopener noreferrer"
      class="block px-4 py-2 w-fit no-underline bg-bg-dark text-text-bright hover:opacity-20"
    >
      > github
    </a>
    <a
      href="https://linkedin.com/in/fabiodicecca"
      target="_blank"
      rel="noopener noreferrer"
      class="block px-4 py-2 w-fit no-underline bg-bg-dark text-text-bright hover:opacity-20"
    >
      > linkedin
    </a>
  </div>

  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    class="flex flex-col gap-3 w-full max-w-sm"
  >
    <input
      type="hidden"
      name="access_key"
      value="d4f27017-4646-4867-929c-c5a5b0cc7894"
    />
    <input type="hidden" name="subject" value="Portfolio Contact" />

    <input
      type="text"
      name="name"
      required
      placeholder="Name"
      class="w-full px-4 py-2 bg-transparent border-2 border-text-primary text-text-primary focus:border-black focus:outline-none placeholder:text-text-grey"
    />
    <input
      type="email"
      name="email"
      required
      placeholder="Email"
      class="w-full px-4 py-2 bg-transparent border-2 border-text-primary text-text-primary focus:border-black focus:outline-none placeholder:text-text-grey"
    />
    <textarea
      name="message"
      required
      placeholder="Message"
      rows="4"
      class="w-full px-4 py-2 bg-transparent border-2 border-text-primary text-text-primary focus:border-black focus:outline-none placeholder:text-text-grey resize-none"
    ></textarea>

    <Button text="send message" type="submit" />
  </form>
</div>
