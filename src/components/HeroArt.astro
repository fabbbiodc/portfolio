---
// Hero animation with three.js
---

<canvas
  id="hero-animation"
  class="w-full h-full -z-10 opacity-80 pointer-events-none"></canvas>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
  import { EffectComposer } from "three/examples/jsm/Addons.js";
  import { RenderPixelatedPass } from "three/examples/jsm/Addons.js";
  import { length } from "astro:schema";
  import { OutlinePass } from "three/examples/jsm/Addons.js";

  function init() {
    const canvas = document.getElementById(
      "hero-animation",
    ) as HTMLCanvasElement;
     if (!canvas) {
      console.error("Canvas not found!");
      return;
    }

    // Scenes
    const mainScene = new THREE.Scene();
    mainScene.background = null;

    const screenScene = new THREE.Scene();
    screenScene.background = new THREE.Color(0x000000);

    // Cameras
    const mainCamera = new THREE.PerspectiveCamera(
      75,
      canvas.clientWidth / canvas.clientHeight,
      0.1,
      1000,
    );

    mainCamera.position.set(0, 0, 2);

    const screenCamera = new THREE.PerspectiveCamera(75, 1, 0.1, 1000);
    screenCamera.position.set(3, 2, 1);

    // Renderers
    const mainRenderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
    });

    mainRenderer.setSize(canvas.clientWidth, canvas.clientHeight);
    mainRenderer.setClearColor(0x000000, 0);
    mainRenderer.setPixelRatio(window.devicePixelRatio);

    const renderTarget = new THREE.WebGLRenderTarget(512, 512);

    // Lights
    const mainAmbientLight = new THREE.AmbientLight(0xffffff, 3);
    mainScene.add(mainAmbientLight);
    const mainDirectionalLight = new THREE.DirectionalLight(0xffffff, 2);
    mainDirectionalLight.position.set(5, 10, 2);
    mainScene.add(mainDirectionalLight);

    const screenAmbientLight = new THREE.AmbientLight(0xffffff, 1);
    screenScene.add(screenAmbientLight);
    const screenDirectionalLight = new THREE.DirectionalLight(0xffffff, 1);
    screenDirectionalLight.position.set(5, 5, 5);
    screenScene.add(screenDirectionalLight);

    // Loaders
    const monitorLoader = new GLTFLoader();
    let monitorGroup: THREE.Group | undefined;

    // Globals for screen mesh, eye tracking, and monitor rotation
    let screenMesh: THREE.Mesh | undefined;
    let screenBox: THREE.Box3 | null = null;
    let screenFrustumWidth = 0;
    let screenFrustumHeight = 0;
    let isRotatingMonitor = false;
    let previousMouseX = 0;
    let previousMouseY = 0;
    let monitorTargetRotationY = 0;
    let monitorTargetRotationX = 0;
    let monitorCurrentRotationY = 0;
    let monitorCurrentRotationX = 0;

    let eyeModel;
    const eyeLoader = new GLTFLoader();
    eyeLoader.load("/models/eye.glb", function (gltf) {
      eyeModel = gltf.scene;
      const eyeBox = new THREE.Box3().setFromObject(eyeModel);
      const eyeCenter = eyeBox.getCenter(new THREE.Vector3());

      eyeModel.position.sub(eyeCenter);
      screenScene.add(eyeModel);

      const size = new THREE.Vector3();
      eyeBox.getSize(size);
      const maxDim = Math.max(size.x, size.y, size.z);

      screenCamera.position.set(0, 0, maxDim * 1.5);
      screenCamera.lookAt(0, 0, 0);

      // Compute screen scene frustum size at z=0 for eye positioning
      const distance = screenCamera.position.z;
      const vFov = THREE.MathUtils.degToRad(screenCamera.fov);
      screenFrustumHeight = 2 * distance * Math.tan(vFov / 2);
      screenFrustumWidth = screenFrustumHeight * screenCamera.aspect;
    });

    // Mouse event handlers for monitor rotation and eye tracking
    const mouse = new THREE.Vector2();
    const raycaster = new THREE.Raycaster();

    document.addEventListener("mousedown", (event) => {
      mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
      mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
      raycaster.setFromCamera(mouse, mainCamera);

      if (monitorGroup) {
        const intersects = raycaster.intersectObject(monitorGroup, true);
        if (intersects.length > 0) {
          isRotatingMonitor = true;
          previousMouseX = event.clientX;
          previousMouseY = event.clientY;
          event.preventDefault();
        }
      }
    });

    document.addEventListener("mousemove", (event) => {
      // --- Eye tracking (always active) ---
      if (eyeModel && screenMesh && screenBox && screenFrustumWidth > 0) {
        mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
        mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
        raycaster.setFromCamera(mouse, mainCamera);

        const intersects = raycaster.intersectObject(screenMesh);
        if (intersects.length > 0) {
          const hitPoint = intersects[0].point.clone();
          const localPoint = screenMesh.worldToLocal(hitPoint);
          const u = (localPoint.x - screenBox.min.x) / (screenBox.max.x - screenBox.min.x);
          const v = (localPoint.y - screenBox.min.y) / (screenBox.max.y - screenBox.min.y);
          const clampedU = Math.max(0, Math.min(1, u));
          const clampedV = Math.max(0, Math.min(1, v));
          eyeModel.position.x = (clampedU - 0.5) * screenFrustumWidth;
          eyeModel.position.y = (clampedV - 0.5) * screenFrustumHeight;
        }
      }

      // --- Monitor rotation (only when rotating) ---
      if (isRotatingMonitor && monitorGroup) {
        const deltaX = event.clientX - previousMouseX;
        const deltaY = event.clientY - previousMouseY;
        const rotationSensitivity = 0.005;

        monitorTargetRotationY += deltaX * rotationSensitivity;
        monitorTargetRotationX += deltaY * rotationSensitivity;

        const maxRotationX = Math.PI * 0.25;
        const maxRotationY = Math.PI * 0.25;
        monitorTargetRotationX = Math.max(-maxRotationX, Math.min(maxRotationX, monitorTargetRotationX));
        monitorTargetRotationY = Math.max(-maxRotationY, Math.min(maxRotationY, monitorTargetRotationY));

        previousMouseX = event.clientX;
        previousMouseY = event.clientY;
      }
    });

    document.addEventListener("mouseup", () => {
      isRotatingMonitor = false;
    });

    // Pixelation composer
    const composer = new EffectComposer(mainRenderer);

    const renderPixelatedPass = new RenderPixelatedPass(
      1,
      mainScene,
      mainCamera,
    );
    composer.addPass(renderPixelatedPass);

    monitorLoader.load("/models/monitor.glb", (gltf) => {
      // Create a group to wrap the model
      monitorGroup = new THREE.Group();
      const monitor = gltf.scene;
      monitor.scale.set(3, 3, 3);
      // Rotate model 90 degrees to face the viewer
      // loadedModel.rotation.x = Math.PI / 2;

      // Add loaded model as child to the group
      monitorGroup.add(monitor);

      screenMesh = monitor.getObjectByName(
        "Cylinder003_Material004_0",
      ) as THREE.Mesh | undefined;
      console.log(screenMesh?.type);

      if (screenMesh) {
        screenMesh.geometry.computeBoundingBox();
        screenBox = screenMesh.geometry.boundingBox;
        if (!screenBox) return;
        const positionAttribute = screenMesh.geometry.attributes.position;
        const uvAttribute = screenMesh.geometry.attributes.uv;

        for (let i = 0; i < positionAttribute.count; i++) {
          const x = positionAttribute.getX(i);
          const y = positionAttribute.getY(i);

          const u = (x - screenBox.min.x) / (screenBox.max.x - screenBox.min.x);
          const v = (y - screenBox.min.y) / (screenBox.max.y - screenBox.min.y);

          uvAttribute.setXY(i, u, v);
        }

        uvAttribute.needsUpdate = true;

        screenMesh.material = new THREE.MeshBasicMaterial({
          map: renderTarget.texture,
        });
      }
      // // Wireframe effect
      // loadedModel.traverse((child) => {
      //   if (child instanceof THREE.Mesh) {
      //     const edges = new THREE.EdgesGeometry(child.geometry);
      //     const lineMaterial = new THREE.LineBasicMaterial({
      //       color: child.material.color || 0xffffff,
      //       // color: 0xff00ff,
      //     });
      //     const line = new THREE.LineSegments(edges, lineMaterial);
      //     child.add(line);

      //     child.material.transparent = true;
      //     child.material.opacity = 0.5;
      //   }
      // });

      // Auto-center the loaded model within the group by computing its bounding box
      const monitorBox = new THREE.Box3().setFromObject(monitor);
      const center = monitorBox.getCenter(new THREE.Vector3());

      // Offset the loaded model so its center aligns with the group's origin
      monitor.position.sub(center);

      mainScene.add(monitorGroup);
      console.log("Model loaded and centered in group");
      animate();
    });

    function animate() {
      requestAnimationFrame(animate);
      if (monitorGroup) {
        const easing = 0.1;
        monitorCurrentRotationX += (monitorTargetRotationX - monitorCurrentRotationX) * easing;
        monitorCurrentRotationY += (monitorTargetRotationY - monitorCurrentRotationY) * easing;
        monitorGroup.rotation.x = monitorCurrentRotationX;
        monitorGroup.rotation.y = monitorCurrentRotationY;
      }
      mainRenderer.setRenderTarget(renderTarget);
      mainRenderer.render(screenScene, screenCamera);
      mainRenderer.setRenderTarget(null);
      composer.render();
    }

    function onWindowResize() {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      mainCamera.aspect = width / height;
      mainCamera.updateProjectionMatrix();
      mainRenderer.setSize(width, height);
      composer.setSize(width, height);
    }
    window.addEventListener("resize", onWindowResize);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
