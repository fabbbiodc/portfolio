---
import { projectCardStyle, markdownContentStyle } from "../styles/styles";

interface Props {
  id: string;
  title: string;
  tags: string[];
  thumbnail: string;
}

const { id, title, tags, thumbnail } = Astro.props;
const tagsString = tags.join(" / ");
---

<button
  class={projectCardStyle}
  data-action="open-window"
  data-target="details"
  data-project-title={title}
  data-project-id={id}
>
  <div class={`${markdownContentStyle}`}>
    <h3 class="text-base md:text-lg !text-text-bright !font-normal bg-bg-dark inline-block pl-1">{title}</h3>
  </div>
  <div class="text-xs text-text-grey">
    {tagsString}
  </div>
  <img src={thumbnail} alt={title} class="w-full h-auto object-left object-contain md:max-h-[120px]" />
</button>
