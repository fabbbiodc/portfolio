---
import { readFileSync } from "node:fs"
import { marked } from "marked"
import { projects } from "../data/projects"

type ProcessedProject = {
  id: string
  title: string
  tags: string[]
  links: { text: string; url: string }[]
  bodyHtml: string
}

const processedProjects: ProcessedProject[] = projects.map((project) => {
  const md = readFileSync(`public${project.content}`, "utf-8")
  const tokens = marked.lexer(md)
  const bodyTokens = tokens.filter((t) => !(t.type === "heading" && t.depth === 1))
  let bodyHtml = marked.parser(bodyTokens)
  bodyHtml = bodyHtml.replace(/src="pictures\//g, 'src="/projects/pictures/')
  return {
    id: project.id,
    title: project.title,
    tags: project.tags,
    links: project.links,
    bodyHtml,
  }
})

import { markdownContentStyle } from "../styles/styles"
---

<div class="flex flex-col gap-4" id="project-detail-content">
  {processedProjects.map((project) => (
    <div data-project-content={project.id} style="display: none;">
      <div>
        <h1
          class="text-xl md:text-2xl text-text-primary font-normal mb-2"
        >
          {project.title}
        </h1>
      </div>

      <div class="flex flex-wrap gap-2">
        {project.tags.map((tag) => (
          <span class="border border-bg-dark bg-bg-primary text-text-primary text-xs px-2 py-0.5">
            {tag}
          </span>
        ))}
      </div>

      {project.links.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-2">
          {project.links.map((link) => (
            <a href={link.url}>{link.text}</a>
          ))}
        </div>
      )}

      <div class={`${markdownContentStyle}`}>
        <div set:html={project.bodyHtml} />
      </div>
    </div>
  ))}
</div>

<script>
  const content = document.querySelector("#project-detail-content");
  let overlay: HTMLElement | null = null;
  let overlayImg: HTMLImageElement | null = null;

  function createOverlay() {
    overlay = document.createElement("div");
    overlay.className =
      "fixed inset-0 z-[9999] flex items-center justify-center bg-black/80 cursor-pointer";
    overlay.addEventListener("click", closeOverlay);

    overlayImg = document.createElement("img");
    overlayImg.className =
      "max-w-[90vw] max-h-[80vh] object-contain border-4 border-double border-bg-dark shadow-lg bg-bg-primary cursor-default";
    overlayImg.addEventListener("click", (e) => e.stopPropagation());
    overlay.appendChild(overlayImg);
    document.body.appendChild(overlay);
  }

  function openOverlay(src: string) {
    if (!overlay) createOverlay();
    if (overlayImg) overlayImg.src = src;
    overlay?.classList.remove("hidden");
  }

  function closeOverlay() {
    overlay?.classList.add("hidden");
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeOverlay();
  });

  content?.addEventListener("click", (e) => {
    const img = (e.target as HTMLElement).closest("img");
    if (!img || !content?.contains(img)) return;
    openOverlay(img.src);
  });
</script>

<style is:global>
  #project-detail-content a {
    display: inline-block;
    background: var(--color-bg-dark);
    color: var(--color-text-bright);
    padding: 0.125rem 0.5rem;
    text-decoration: none;
  }
  #project-detail-content a::before {
    content: ">";
    margin-right: 0.25em;
  }
  #project-detail-content a:hover {
    opacity: 0.2;
  }
  #project-detail-content img {
    width: 100%;
    max-height: 400px;
    object-fit: contain;
    object-position: left;
  }
  @media (max-width: 767px) {
    #project-detail-content img {
      max-height: none;
    }
  }
</style>
