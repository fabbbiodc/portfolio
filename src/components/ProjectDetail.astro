---
import { readFileSync } from "node:fs"
import { marked } from "marked"

const md = readFileSync("public/projects/project_01.md", "utf-8")
const html = await marked(md)
const processed = html.replace(
  /src="pictures\//g,
  'src="/projects/pictures/',
)

import { markdownContentStyle } from "../styles/styles"
---

<div class={`${markdownContentStyle} max-h-[75vh] overflow-y-auto`}>">
  <fragment set:html={processed} />
</div>